# Import from the host's existing /etc/caddy/Caddyfile. No access logging:
# OIDC callbacks carry codes in the query string.
board.sunsetproject.online {
    header {
        -Server
        X-Robots-Tag "noindex, nofollow, noarchive"
    }

    handle_errors {
        header Cache-Control "no-store"
        respond "Сервис временно недоступен." {http.error.status_code}
    }

    reverse_proxy 127.0.0.1:5174 {
        header_up Host board.sunsetproject.online
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto https
        header_up -Forwarded
        header_up -X-Forwarded-For
        header_up -X-Forwarded-Host
        header_down -Server
        transport http {
            dial_timeout 2s
            response_header_timeout 40s
            read_timeout 40s
            write_timeout 10s
            max_conns_per_host 16
        }
    }
}
