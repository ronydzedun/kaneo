# Copy to .env next to compose.yml. Secrets live in ./secrets (mode 0600).
KANEO_CLIENT_URL=https://board.sunsetproject.online

# The panel IdP is the only sign-in method. Email and SMTP stay optional.
EXTERNAL_IDENTITY_ISSUER=https://auth.sunsetproject.online
EXTERNAL_OIDC_CLIENT_ID=kaneo-board

# Panel accounts are provisioned and revoked through the machine endpoint.
DISABLE_GUEST_ACCESS=true
DISABLE_EMAIL_OTP_SIGN_IN=true
DISABLE_REGISTRATION=true

# Optional image hosting. Leave unset to disable uploads.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Optional cross-instance realtime. A single instance works without Redis.
# REDIS_URL=redis://redis:6379
